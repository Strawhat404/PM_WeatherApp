# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Used by Next.js app (via Prisma)
DATABASE_URL="postgresql://weather_user:weather_pass@localhost:5432/weather_db"

# ─────────────────────────────────────────────
# Weather API  (OpenWeatherMap)
# Sign up free at: https://openweathermap.org/api
# Free tier: 1,000 calls/day
# ─────────────────────────────────────────────
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# ─────────────────────────────────────────────
# YouTube Data API v3
# Get key at: https://console.cloud.google.com
# Enable "YouTube Data API v3" in your project
# Free tier: 10,000 units/day
# ─────────────────────────────────────────────
YOUTUBE_API_KEY="your_youtube_api_key_here"

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
